# Tâm An Care - Development Gitignore

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build outputs
dist/
build/
.next/
out/
*.out

# Environment variables & Secret Files (NEVER COMMIT)
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
!.env.example
*.pem
*.key
*.crt
secrets/

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.bak

# Python
__pycache__/
*.pyc

# Database dumps, backups and restore artifacts (NEVER COMMIT)
/database/backups/
**/backups/
*.dump
*.sql.gz
*.pgdump
*.backup
*.tar.gz
*.age
*.gpg

# Sensitive local exports and credentials
*.p12
*.pfx
*.jks
*.kdbx
*.sqlite
*.sqlite3
*.db
*.csv.gz
