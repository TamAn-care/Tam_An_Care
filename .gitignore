# Tâm An Care - Development Gitignore

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build outputs & TypeScript incremental builds
dist/
build/
.next/
out/
*.out
*.tsbuildinfo
*.js.map

# Environment variables & Secret Files (NEVER COMMIT)
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
!.env.example
*.pem
*.key
*.crt
secrets/

# Temporary, Backup & Artifact Files
*.log
*.tmp
*.bak
*.backup*
*.pre-*
*.dump
*.failed-build-copy
*.pre-write
*.zip

# AI Agents & Automation Artifacts
.agents/

# Python
__pycache__/
*.pyc
