# Tâm An Care - Development Gitignore

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build outputs
dist/
build/
.next/
out/
*.out

# Environment variables & Secret Files (NEVER COMMIT)
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
!.env.example
*.pem
*.key
*.crt
secrets/

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.bak

# Python
__pycache__/
*.pyc
