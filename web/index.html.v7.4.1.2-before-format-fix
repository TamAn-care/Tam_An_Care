.evidence-row:last-child{
  border-bottom:0;
}

.evidence-key{
  color:#64716b;
}

.evidence-value{
  font-weight:600;
  text-align:right;
  word-break:break-word;
}

.evidence-empty{
  padding:12px;
  color:#7b8680;
  font-size:12px;
}

.human-review-panel{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin:20px 0;
  padding:16px;
  border-radius:12px;
  border:1px solid #ead9a8;
  background:#fffaf0;
}

.human-review-content{
  display:flex;
  align-items:center;
  gap:12px;
}

.human-review-icon{
  width:32px;
  height:32px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  background:#f1c75b;
  color:#604600;
}

.human-review-title{
  font-weight:800;
  color:#634b00;
}

.human-review-subtitle{
  margin-top:3px;
  font-size:12px;
  color:#756846;
}

.human-review-action{
  display:flex;
  align-items:center;
  gap:10px;
}

.review-status{
  font-size:11px;
  font-weight:800;
  padding:5px 9px;
  border-radius:12px;
  background:#fff0cf;
  color:#8b6200;
}

.review-status.ACKNOWLEDGED{
  background:#e5f4e9;
  color:#28643c;
}

.acknowledge-button{
  border:0;
  border-radius:8px;
  padding:9px 13px;
  background:#315f46;
  color:white;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
}

.acknowledge-button:hover{
  opacity:.9;
}

.acknowledge-button:disabled{
  cursor:default;
  opacity:.75;
}

.acknowledge-button.acknowledged{
  background:#4b8060;
}

.empty-filter{
  padding:20px;
  text-align:center;
  color:#69756f;
}

@media(max-width:700px){

  .human-review-panel{
    flex-direction:column;
    align-items:stretch;
  }

  .human-review-action{
    justify-content:space-between;
  }

  .pattern-header{
    align-items:flex-start;
  }

  .pattern-severity{
    margin-left:auto;
  }

  .pattern-details{
    padding-left:16px;
  }

  .evidence-row{
    flex-direction:column;
    gap:3px;
  }

  .evidence-value{
    text-align:left;
  }
}

</style>

</head>

<body>

<header>
  <div>
    <div class="brand">TÂM AN CARE</div>
    <div class="subtitle">Health Trend AI • Early Warning Dashboard</div>
  </div>

  <div class="header-status">
    V7.4.1.1 • Human-in-the-loop
  </div>
</header>

<main>

  <div class="page-title">
    <h1>Early Warning — Health Trend</h1>
    <p>Phát hiện các xu hướng sức khỏe cần nhân viên chăm sóc xem xét.</p>
  </div>

  <div class="toolbar">
    <button class="primary" onclick="loadEarlyWarning()">
      ↻ Phân tích lại
    </button>

    <button class="secondary" onclick="loadDemo()">
      Dữ liệu Demo
    </button>
  </div>

  <div id="loading" class="card loading">
    Đang tải phân tích Early Warning...
  </div>

  <div id="error" class="error hidden"></div>

  <section id="result" class="card early-warning hidden">

    <div class="warning-header">

      <div>
        <div class="warning-title">
          Health Trend Early Warning
        </div>

        <div class="warning-subtitle" id="period">
          —
        </div>
      </div>

      <div id="warningLevel" class="level UNKNOWN">
        UNKNOWN
      </div>

    </div>

    <div class="summary-grid">

      <div class="metric-card">
        <div class="metric-label">Confidence</div>
        <div class="metric-value" id="confidence">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Patterns</div>
        <div class="metric-value" id="patternCount">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Health domains</div>
        <div class="metric-value" id="metricsAffected">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Data points</div>
        <div class="metric-value" id="dataPoints">—</div>
      </div>

    </div>

    <div class="review-banner">
      <div class="review-icon">⚠</div>

      <div>
        <strong>HUMAN REVIEW REQUIRED</strong>
        <div id="reviewStatus">
          PENDING
        </div>
      </div>
    </div>

    <div class="section-title">
      Warning Patterns
    </div>

    <div id="patterns" class="patterns"></div>

    <div class="section-title">
      Recommendation
    </div>

    <div class="card">
      <div id="recommendation">—</div>
    </div>

    <div class="footer-note">
      Đây là công cụ hỗ trợ phát hiện xu hướng dựa trên rules engine.
      Kết quả không thay thế đánh giá chuyên môn của nhân viên chăm sóc
      hoặc cán bộ y tế. Không thực hiện autonomous clinical action.
    </div>

  </section>

</main>

<script>

const DEMO_OBSERVATIONS = [
  {
    date:"2026-07-18",
    weightKg:63,
    foodFluidIntakePercent:72,
    sleepHours:7,
    spo2:97,
    mobility:"ASSISTED"
  },
  {
    date:"2026-07-25",
    weightKg:62.1,
    foodFluidIntakePercent:68,
    sleepHours:6.2,
    spo2:96,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-01",
    weightKg:61,
    foodFluidIntakePercent:63,
    sleepHours:5.2,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-08",
    weightKg:60.4,
    foodFluidIntakePercent:59,
    sleepHours:4.9,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-15",
    weightKg:59.8,
    foodFluidIntakePercent:55,
    sleepHours:4.5,
    spo2:93,
    mobility:"HIGH_ASSISTANCE"
  }
];

function showLoading(){
  document.getElementById("loading").classList.remove("hidden");
  document.getElementById("result").classList.add("hidden");
  document.getElementById("error").classList.add("hidden");
}

function showError(message){
  document.getElementById("loading").classList.add("hidden");

  const box=document.getElementById("error");
  box.textContent=message;
  box.classList.remove("hidden");

  document.getElementById("result").classList.add("hidden");
}

function renderPattern(pattern){

  const evidence=pattern.evidence || {};

  let rows="";

  Object.entries(evidence).forEach(([key,value])=>{

    if(Array.isArray(value)){
      value=value.join(", ");
    }

    rows += `
      <div class="evidence-row">
        <span>${formatKey(key)}</span>
        <strong>${value}</strong>
      </div>
    `;
  });

  return `
    <div class="pattern">

      <div class="pattern-head">

        <div class="pattern-type">
          ${formatPattern(pattern.type)}
        </div>

        <div class="badge ${pattern.severity}">
          ${pattern.severity}
        </div>

      </div>

      <div class="pattern-message">
        ${pattern.message || ""}
      </div>

      <div class="evidence">
        ${rows}
      </div>

    </div>
  `;
}

function formatPattern(type){

  const labels={
    PERSISTENT_DECLINE:"Persistent decline",
    ACCELERATING_DECLINE:"Accelerating decline",
    MOBILITY_DETERIORATION:"Mobility deterioration",
    MULTI_SIGNAL_CONVERGENCE:"Multi-signal convergence"
  };

  return labels[type] || type;
}

function formatKey(key){

  const labels={
    baseline:"Baseline",
    current:"Current",
    changePercent:"Change",
    decliningSteps:"Declining steps",
    observations:"Observations",
    rankChange:"Rank change",
    signalCount:"Signal count",
    metrics:"Metrics",
    earlyAverageChange:"Early avg. change",
    recentAverageChange:"Recent avg. change"
  };

  return labels[key] || key;
}


let currentEarlyWarningData = null;
let currentSeverityFilter = "ALL";
let acknowledgedReview = false;
let expandedPatterns = new Set();

function severityRank(level){
  return {
    HIGH: 3,
    MODERATE: 2,
    LOW: 1,
    UNKNOWN: 0
  }[level] ?? 0;
}

function severityClass(level){
  return String(level || "UNKNOWN").toUpperCase();
}

function renderEvidence(evidence){

  if(!evidence || typeof evidence !== "object"){
    return `
      <div class="evidence-empty">
        No evidence available.
      </div>
    `;
  }

  return Object.entries(evidence)
    .map(([key,value]) => {

      let displayValue = value;

      if(Array.isArray(value)){
        displayValue = value.join(", ");
      }else if(
        value !== null &&
        typeof value === "object"
      ){
        displayValue = JSON.stringify(value);
      }

      return `
        <div class="evidence-row">
          <span class="evidence-key">
            ${escapeHtml(formatKey(key))}
          </span>
          <span class="evidence-value">
            ${escapeHtml(String(displayValue))}
          </span>
        </div>
      `;
    })
    .join("");
}

function escapeHtml(value){

  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function renderPattern(pattern,index){

  const id = pattern.patternId || `pattern-${index}`;
  const severity = severityClass(pattern.severity);
  const expanded = expandedPatterns.has(id);

  return `
    <div
      class="pattern-card ${severity}"
      data-pattern-id="${escapeHtml(id)}"
    >

      <button
        class="pattern-header"
        type="button"
        onclick="togglePattern('${escapeHtml(id)}')"
        aria-expanded="${expanded}"
      >

        <span class="pattern-toggle">
          ${expanded ? "▼" : "▶"}
        </span>

        <span class="pattern-main">

          <span class="pattern-title">
            ${escapeHtml(
              formatPatternType(pattern.type)
            )}
          </span>

          <span class="pattern-message">
            ${escapeHtml(pattern.message || "")}
          </span>

        </span>

        <span class="pattern-severity ${severity}">
          ${escapeHtml(severity)}
        </span>

      </button>

      ${
        expanded
          ? `
            <div class="pattern-details">

              <div class="pattern-metrics">
                ${
                  (pattern.metrics || [])
                    .map(metric => `
                      <span class="metric-chip">
                        ${escapeHtml(metric)}
                      </span>
                    `)
                    .join("")
                }
              </div>

              <div class="evidence-title">
                Evidence
              </div>

              <div class="evidence-box">
                ${renderEvidence(pattern.evidence)}
              </div>

            </div>
          `
          : ""
      }

    </div>
  `;
}

function togglePattern(id){

  if(expandedPatterns.has(id)){
    expandedPatterns.delete(id);
  }else{
    expandedPatterns.add(id);
  }

  if(currentEarlyWarningData){
    render(currentEarlyWarningData);
  }
}

function setSeverityFilter(level){

  currentSeverityFilter = level;

  render(currentEarlyWarningData);
}

function acknowledgeReview(){

  acknowledgedReview = true;

  const button =
    document.getElementById("acknowledgeReview");

  const status =
    document.getElementById("reviewStatus");

  if(button){
    button.textContent = "Review Acknowledged";
    button.disabled = true;
    button.classList.add("acknowledged");
  }

  if(status){
    status.textContent = "ACKNOWLEDGED";
    status.className = "review-status ACKNOWLEDGED";
  }
}

function renderFilterBar(){

  const filters = [
    "ALL",
    "HIGH",
    "MODERATE",
    "LOW"
  ];

  return `
    <div class="severity-filter">

      <div class="filter-label">
        Filter alerts
      </div>

      <div class="filter-buttons">

        ${
          filters.map(level => `
            <button
              type="button"
              class="filter-button ${
                currentSeverityFilter === level
                  ? "active"
                  : ""
              } ${level}"
              onclick="setSeverityFilter('${level}')"
            >
              ${level}
            </button>
          `).join("")
        }

      </div>

    </div>
  `;
}

function renderHumanReview(data){

  const required =
    data.humanReviewRequired === true;

  if(!required){
    return "";
  }

  const acknowledged =
    acknowledgedReview ||
    data.humanReviewStatus === "ACKNOWLEDGED";

  return `
    <div class="human-review-panel">

      <div class="human-review-content">

        <div class="human-review-icon">
          !
        </div>

        <div>

          <div class="human-review-title">
            Human Review Required
          </div>

          <div class="human-review-subtitle">
            Detected patterns require review by the care team.
          </div>

        </div>

      </div>

      <div class="human-review-action">

        <span
          id="reviewStatus"
          class="review-status ${
            acknowledged
              ? "ACKNOWLEDGED"
              : "PENDING"
          }"
        >
          ${
            acknowledged
              ? "ACKNOWLEDGED"
              : "PENDING"
          }
        </span>

        <button
          id="acknowledgeReview"
          type="button"
          class="acknowledge-button ${
            acknowledged
              ? "acknowledged"
              : ""
          }"
          ${
            acknowledged
              ? "disabled"
              : ""
          }
          onclick="acknowledgeReview()"
        >
          ${
            acknowledged
              ? "Review Acknowledged"
              : "Acknowledge Review"
          }
        </button>

      </div>

    </div>
  `;
}

function render(data){

  if(!data){
    return;
  }

  currentEarlyWarningData = data;

  document
    .getElementById("loading")
    .classList.add("hidden");

  document
    .getElementById("error")
    .classList.add("hidden");

  const result =
    document.getElementById("result");

  result.classList.remove("hidden");

  const level =
    data.warningLevel || "UNKNOWN";

  const levelBox =
    document.getElementById("warningLevel");

  levelBox.textContent = level;
  levelBox.className =
    "level " + severityClass(level);

  document.getElementById("confidence").textContent =
    data.confidence === null ||
    data.confidence === undefined
      ? "—"
      : Math.round(data.confidence * 100) + "%";

  document.getElementById("patternCount").textContent =
    data.patternCount ??
    (data.patterns || []).length;

  document.getElementById("metricsAffected").textContent =
    (data.metricsAffected || []).length;

  document.getElementById("dataPoints").textContent =
    data.dataPoints ?? "—";

  if(data.period){

    document.getElementById("period").textContent =
      `${data.period.from} → ${data.period.to}`;
  }

  document.getElementById("recommendation").textContent =
    data.recommendation || "—";

  const reviewContainer =
    document.getElementById("reviewStatus");

  if(reviewContainer){

    reviewContainer.textContent =
      acknowledgedReview
        ? "ACKNOWLEDGED"
        : data.humanReviewStatus || "PENDING";
  }

  /*
   * Insert / refresh Human Review panel.
   */
  let reviewPanel =
    document.getElementById("humanReviewPanel");

  if(!reviewPanel){

    const patternsContainer =
      document.getElementById("patterns");

    reviewPanel =
      document.createElement("div");

    reviewPanel.id = "humanReviewPanel";

    patternsContainer.parentNode.insertBefore(
      reviewPanel,
      patternsContainer
    );
  }

  reviewPanel.innerHTML =
    renderHumanReview(data);

  /*
   * Insert severity filters.
   */
  let filterContainer =
    document.getElementById("severityFilter");

  if(!filterContainer){

    filterContainer =
      document.createElement("div");

    filterContainer.id =
      "severityFilter";

    const patternsContainer =
      document.getElementById("patterns");

    patternsContainer.parentNode.insertBefore(
      filterContainer,
      patternsContainer
    );
  }

  filterContainer.innerHTML =
    renderFilterBar();

  /*
   * Filter patterns.
   */
  const allPatterns =
    Array.isArray(data.patterns)
      ? data.patterns
      : [];

  const filteredPatterns =
    currentSeverityFilter === "ALL"
      ? allPatterns
      : allPatterns.filter(
          pattern =>
            severityClass(pattern.severity) ===
            currentSeverityFilter
        );

  const container =
    document.getElementById("patterns");

  if(allPatterns.length === 0){

    container.innerHTML = `
      <div class="card">
        Không phát hiện early-warning pattern.
      </div>
    `;

    return;
  }

  if(filteredPatterns.length === 0){

    container.innerHTML = `
      <div class="card empty-filter">
        Không có cảnh báo mức
        <strong>${escapeHtml(currentSeverityFilter)}</strong>.
      </div>
    `;

    return;
  }

  container.innerHTML =
    filteredPatterns
      .map(renderPattern)
      .join("");
}


async function callEarlyWarning(observations){

  showLoading();

  try{

    const response=await fetch(
      "/api/ai/engines/health-trend/patterns",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          observations
        })
      }
    );

    if(!response.ok){

      throw new Error(
        `API returned HTTP ${response.status}`
      );
    }

    const data=await response.json();

    console.log("[Early Warning] API response:", data);

    try {
      render(data);
      console.log("[Early Warning] render() PASS");
    } catch(renderError) {
      console.error("[Early Warning] render() FAILED:", renderError);

      showError(
        "API đã kết nối thành công nhưng UI render bị lỗi: " +
        (renderError?.message || renderError)
      );
    }

  }catch(error){

    console.error("[Early Warning] API request FAILED:", error);

    showError(
      "Không thể kết nối Early Warning API: " +
      (error?.message || error)
    );
  }
}

function loadEarlyWarning(){
  callEarlyWarning(DEMO_OBSERVATIONS);
}

function loadDemo(){
  callEarlyWarning(DEMO_OBSERVATIONS);
}

loadEarlyWarning();

</script>

