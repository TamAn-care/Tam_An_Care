}

.evidence-title{
  font-size:13px;
  font-weight:700;
  margin:12px 0 7px;
}

.evidence-box{
  border:1px solid #e3e8e5;
  border-radius:8px;
  overflow:hidden;
  background:#fafcfb;
}

.evidence-row{
  display:flex;
