<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tâm An Care — Early Warning</title>

<style>
:root{
  --green:#176b52;
  --green2:#238b6c;
  --green-light:#eaf6f1;
  --ink:#17332a;
  --muted:#66756f;
  --line:#dfe9e4;
  --bg:#f5f8f6;
  --white:#fff;
  --red:#c62828;
  --red-bg:#fff0f0;
  --orange:#c77800;
  --orange-bg:#fff7e8;
  --yellow:#9a7600;
  --yellow-bg:#fffbea;
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  background:var(--bg);
  color:var(--ink);
}

header{
  background:var(--green);
  color:white;
  padding:16px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:20;
}

.brand{
  font-size:20px;
  font-weight:800;
}

.subtitle{
  font-size:12px;
  opacity:.8;
  margin-top:3px;
}

.header-status{
  font-size:12px;
  background:#ffffff20;
  padding:7px 10px;
  border-radius:20px;
}

main{
  max-width:1200px;
  margin:auto;
  padding:22px;
}

.page-title{
  margin-bottom:18px;
}

.page-title h1{
  margin:0;
  font-size:27px;
}

.page-title p{
  margin:6px 0 0;
  color:var(--muted);
}

.toolbar{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:18px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 16px;
  cursor:pointer;
  font-weight:700;
}

.primary{
  background:var(--green);
  color:white;
}

.secondary{
  background:white;
  border:1px solid var(--line);
  color:var(--ink);
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:20px;
  box-shadow:0 4px 18px #17332a0b;
}

.early-warning{
  border-left:6px solid var(--red);
}

.warning-header{
  display:flex;
  justify-content:space-between;
  gap:15px;
  align-items:flex-start;
  flex-wrap:wrap;
}

.warning-title{
  font-size:18px;
  font-weight:800;
}

.warning-subtitle{
  color:var(--muted);
  font-size:13px;
  margin-top:4px;
}

.level{
  padding:9px 18px;
  border-radius:999px;
  font-size:14px;
  font-weight:900;
}

.level.HIGH{
  color:var(--red);
  background:var(--red-bg);
}

.level.MODERATE{
  color:var(--orange);
  background:var(--orange-bg);
}

.level.LOW{
  color:var(--yellow);
  background:var(--yellow-bg);
}

.level.NONE{
  color:var(--green);
  background:var(--green-light);
}

.level.UNKNOWN{
  color:#777;
  background:#f1f1f1;
}

.summary-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin:18px 0;
}

.metric-card{
  border:1px solid var(--line);
  border-radius:11px;
  padding:14px;
}

.metric-label{
  font-size:12px;
  color:var(--muted);
}

.metric-value{
  margin-top:5px;
  font-size:22px;
  font-weight:800;
}

.review-banner{
  margin:18px 0;
  padding:15px;
  border-radius:11px;
  background:#fff4e5;
  border:1px solid #f0d19e;
  color:#704600;
  display:flex;
  align-items:center;
  gap:12px;
}

.review-icon{
  font-size:23px;
}

.patterns{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.pattern{
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
  background:white;
}

.pattern-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
}

.pattern-type{
  font-weight:800;
}

.badge{
  font-size:11px;
  font-weight:900;
  padding:5px 9px;
  border-radius:20px;
}

.badge.HIGH{
  background:var(--red-bg);
  color:var(--red);
}

.badge.MODERATE{
  background:var(--orange-bg);
  color:var(--orange);
}

.badge.LOW{
  background:var(--yellow-bg);
  color:var(--yellow);
}

.pattern-message{
  color:var(--muted);
  font-size:13px;
  margin:10px 0;
}

.evidence{
  background:#f7faf8;
  border-radius:8px;
  padding:10px;
  font-size:12px;
}

.evidence-row{
  display:flex;
  justify-content:space-between;
  padding:3px 0;
}

.section-title{
  margin:26px 0 12px;
  font-size:17px;
}

.footer-note{
  margin-top:20px;
  color:var(--muted);
  font-size:11px;
  line-height:1.6;
}

.loading{
  text-align:center;
  padding:40px;
  color:var(--muted);
}

.error{
  background:var(--red-bg);
  border:1px solid #f1bcbc;
  color:var(--red);
  padding:15px;
  border-radius:10px;
}

.hidden{
  display:none;
}

@media(max-width:800px){
  main{
    padding:14px;
  }

  .summary-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .patterns{
    grid-template-columns:1fr;
  }
}

@media(max-width:520px){
  header{
    padding:13px 14px;
  }

  .brand{
    font-size:17px;
  }

  .header-status{
    display:none;
  }

  .page-title h1{
    font-size:22px;
  }

  .summary-grid{
    grid-template-columns:1fr 1fr;
  }

  .metric-value{
    font-size:18px;
  }

  .warning-header{
    flex-direction:column;
  }
}
</style>

<style>

.severity-filter{
  margin:20px 0;
  padding:16px;
  border-radius:12px;
  background:#f7f9f8;
  border:1px solid #e2e8e5;
}

.filter-label{
  font-size:13px;
  font-weight:600;
  margin-bottom:10px;
  color:#52605a;
}

.filter-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.filter-button{
  border:1px solid #d5ddd9;
  background:white;
  border-radius:20px;
  padding:7px 14px;
  font-size:12px;
  font-weight:600;
  cursor:pointer;
}

.filter-button:hover{
  transform:translateY(-1px);
}

.filter-button.active{
  box-shadow:0 0 0 2px rgba(40,80,60,.12);
}

.filter-button.HIGH{
  color:#a32020;
}

.filter-button.MODERATE{
  color:#996400;
}

.filter-button.LOW{
  color:#2e6b45;
}

.pattern-card{
  margin:12px 0;
  border:1px solid #e0e6e3;
  border-radius:12px;
  overflow:hidden;
  background:#fff;
}

.pattern-header{
  width:100%;
  display:flex;
  align-items:center;
  gap:12px;
  padding:15px;
  border:0;
  background:transparent;
  cursor:pointer;
  text-align:left;
}

.pattern-header:hover{
  background:#f8faf9;
}

.pattern-toggle{
  width:18px;
  flex:0 0 18px;
  color:#65736c;
}

.pattern-main{
  flex:1;
  min-width:0;
}

.pattern-title{
  display:block;
  font-weight:700;
  margin-bottom:4px;
}

.pattern-message{
  display:block;
  font-size:13px;
  color:#65736c;
}

.pattern-severity{
  flex:0 0 auto;
  border-radius:20px;
  padding:5px 10px;
  font-size:11px;
  font-weight:700;
}

.pattern-severity.HIGH{
  background:#fde8e8;
  color:#a32020;
}

.pattern-severity.MODERATE{
  background:#fff3d6;
  color:#996400;
}

.pattern-severity.LOW{
  background:#e7f4eb;
  color:#2e6b45;
}

.pattern-details{
  padding:0 16px 16px 46px;
  border-top:1px solid #edf1ef;
}

.pattern-metrics{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin:12px 0;
}

.metric-chip{
  display:inline-block;
  padding:4px 8px;
  border-radius:12px;
  background:#eef3f0;
  color:#53615b;
