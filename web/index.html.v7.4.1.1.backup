<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tâm An Care — Early Warning</title>

<style>
:root{
  --green:#176b52;
  --green2:#238b6c;
  --green-light:#eaf6f1;
  --ink:#17332a;
  --muted:#66756f;
  --line:#dfe9e4;
  --bg:#f5f8f6;
  --white:#fff;
  --red:#c62828;
  --red-bg:#fff0f0;
  --orange:#c77800;
  --orange-bg:#fff7e8;
  --yellow:#9a7600;
  --yellow-bg:#fffbea;
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  background:var(--bg);
  color:var(--ink);
}

header{
  background:var(--green);
  color:white;
  padding:16px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:20;
}

.brand{
  font-size:20px;
  font-weight:800;
}

.subtitle{
  font-size:12px;
  opacity:.8;
  margin-top:3px;
}

.header-status{
  font-size:12px;
  background:#ffffff20;
  padding:7px 10px;
  border-radius:20px;
}

main{
  max-width:1200px;
  margin:auto;
  padding:22px;
}

.page-title{
  margin-bottom:18px;
}

.page-title h1{
  margin:0;
  font-size:27px;
}

.page-title p{
  margin:6px 0 0;
  color:var(--muted);
}

.toolbar{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:18px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 16px;
  cursor:pointer;
  font-weight:700;
}

.primary{
  background:var(--green);
  color:white;
}

.secondary{
  background:white;
  border:1px solid var(--line);
  color:var(--ink);
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:20px;
  box-shadow:0 4px 18px #17332a0b;
}

.early-warning{
  border-left:6px solid var(--red);
}

.warning-header{
  display:flex;
  justify-content:space-between;
  gap:15px;
  align-items:flex-start;
  flex-wrap:wrap;
}

.warning-title{
  font-size:18px;
  font-weight:800;
}

.warning-subtitle{
  color:var(--muted);
  font-size:13px;
  margin-top:4px;
}

.level{
  padding:9px 18px;
  border-radius:999px;
  font-size:14px;
  font-weight:900;
}

.level.HIGH{
  color:var(--red);
  background:var(--red-bg);
}

.level.MODERATE{
  color:var(--orange);
  background:var(--orange-bg);
}

.level.LOW{
  color:var(--yellow);
  background:var(--yellow-bg);
}

.level.NONE{
  color:var(--green);
  background:var(--green-light);
}

.level.UNKNOWN{
  color:#777;
  background:#f1f1f1;
}

.summary-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin:18px 0;
}

.metric-card{
  border:1px solid var(--line);
  border-radius:11px;
  padding:14px;
}

.metric-label{
  font-size:12px;
  color:var(--muted);
}

.metric-value{
  margin-top:5px;
  font-size:22px;
  font-weight:800;
}

.review-banner{
  margin:18px 0;
  padding:15px;
  border-radius:11px;
  background:#fff4e5;
  border:1px solid #f0d19e;
  color:#704600;
  display:flex;
  align-items:center;
  gap:12px;
}

.review-icon{
  font-size:23px;
}

.patterns{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.pattern{
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
  background:white;
}

.pattern-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
}

.pattern-type{
  font-weight:800;
}

.badge{
  font-size:11px;
  font-weight:900;
  padding:5px 9px;
  border-radius:20px;
}

.badge.HIGH{
  background:var(--red-bg);
  color:var(--red);
}

.badge.MODERATE{
  background:var(--orange-bg);
  color:var(--orange);
}

.badge.LOW{
  background:var(--yellow-bg);
  color:var(--yellow);
}

.pattern-message{
  color:var(--muted);
  font-size:13px;
  margin:10px 0;
}

.evidence{
  background:#f7faf8;
  border-radius:8px;
  padding:10px;
  font-size:12px;
}

.evidence-row{
  display:flex;
  justify-content:space-between;
  padding:3px 0;
}

.section-title{
  margin:26px 0 12px;
  font-size:17px;
}

.footer-note{
  margin-top:20px;
  color:var(--muted);
  font-size:11px;
  line-height:1.6;
}

.loading{
  text-align:center;
  padding:40px;
  color:var(--muted);
}

.error{
  background:var(--red-bg);
  border:1px solid #f1bcbc;
  color:var(--red);
  padding:15px;
  border-radius:10px;
}

.hidden{
  display:none;
}

@media(max-width:800px){
  main{
    padding:14px;
  }

  .summary-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .patterns{
    grid-template-columns:1fr;
  }
}

@media(max-width:520px){
  header{
    padding:13px 14px;
  }

  .brand{
    font-size:17px;
  }

  .header-status{
    display:none;
  }

  .page-title h1{
    font-size:22px;
  }

  .summary-grid{
    grid-template-columns:1fr 1fr;
  }

  .metric-value{
    font-size:18px;
  }

  .warning-header{
    flex-direction:column;
  }
}
</style>
</head>

<body>

<header>
  <div>
    <div class="brand">TÂM AN CARE</div>
    <div class="subtitle">Health Trend AI • Early Warning Dashboard</div>
  </div>

  <div class="header-status">
    V7.4.1.1 • Human-in-the-loop
  </div>
</header>

<main>

  <div class="page-title">
    <h1>Early Warning — Health Trend</h1>
    <p>Phát hiện các xu hướng sức khỏe cần nhân viên chăm sóc xem xét.</p>
  </div>

  <div class="toolbar">
    <button class="primary" onclick="loadEarlyWarning()">
      ↻ Phân tích lại
    </button>

    <button class="secondary" onclick="loadDemo()">
      Dữ liệu Demo
    </button>
  </div>

  <div id="loading" class="card loading">
    Đang tải phân tích Early Warning...
  </div>

  <div id="error" class="error hidden"></div>

  <section id="result" class="card early-warning hidden">

    <div class="warning-header">

      <div>
        <div class="warning-title">
          Health Trend Early Warning
        </div>

        <div class="warning-subtitle" id="period">
          —
        </div>
      </div>

      <div id="warningLevel" class="level UNKNOWN">
        UNKNOWN
      </div>

    </div>

    <div class="summary-grid">

      <div class="metric-card">
        <div class="metric-label">Confidence</div>
        <div class="metric-value" id="confidence">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Patterns</div>
        <div class="metric-value" id="patternCount">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Health domains</div>
        <div class="metric-value" id="metricsAffected">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Data points</div>
        <div class="metric-value" id="dataPoints">—</div>
      </div>

    </div>

    <div class="review-banner">
      <div class="review-icon">⚠</div>

      <div>
        <strong>HUMAN REVIEW REQUIRED</strong>
        <div id="reviewStatus">
          PENDING
        </div>
      </div>
    </div>

    <div class="section-title">
      Warning Patterns
    </div>

    <div id="patterns" class="patterns"></div>

    <div class="section-title">
      Recommendation
    </div>

    <div class="card">
      <div id="recommendation">—</div>
    </div>

    <div class="footer-note">
      Đây là công cụ hỗ trợ phát hiện xu hướng dựa trên rules engine.
      Kết quả không thay thế đánh giá chuyên môn của nhân viên chăm sóc
      hoặc cán bộ y tế. Không thực hiện autonomous clinical action.
    </div>

  </section>

</main>

<script>

const DEMO_OBSERVATIONS = [
  {
    date:"2026-07-18",
    weightKg:63,
    foodFluidIntakePercent:72,
    sleepHours:7,
    spo2:97,
    mobility:"ASSISTED"
  },
  {
    date:"2026-07-25",
    weightKg:62.1,
    foodFluidIntakePercent:68,
    sleepHours:6.2,
    spo2:96,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-01",
    weightKg:61,
    foodFluidIntakePercent:63,
    sleepHours:5.2,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-08",
    weightKg:60.4,
    foodFluidIntakePercent:59,
    sleepHours:4.9,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-15",
    weightKg:59.8,
    foodFluidIntakePercent:55,
    sleepHours:4.5,
    spo2:93,
    mobility:"HIGH_ASSISTANCE"
  }
];

function showLoading(){
  document.getElementById("loading").classList.remove("hidden");
  document.getElementById("result").classList.add("hidden");
  document.getElementById("error").classList.add("hidden");
}

function showError(message){
  document.getElementById("loading").classList.add("hidden");

  const box=document.getElementById("error");
  box.textContent=message;
  box.classList.remove("hidden");

  document.getElementById("result").classList.add("hidden");
}

function renderPattern(pattern){

  const evidence=pattern.evidence || {};

  let rows="";

  Object.entries(evidence).forEach(([key,value])=>{

    if(Array.isArray(value)){
      value=value.join(", ");
    }

    rows += `
      <div class="evidence-row">
        <span>${formatKey(key)}</span>
        <strong>${value}</strong>
      </div>
    `;
  });

  return `
    <div class="pattern">

      <div class="pattern-head">

        <div class="pattern-type">
          ${formatPattern(pattern.type)}
        </div>

        <div class="badge ${pattern.severity}">
          ${pattern.severity}
        </div>

      </div>

      <div class="pattern-message">
        ${pattern.message || ""}
      </div>

      <div class="evidence">
        ${rows}
      </div>

    </div>
  `;
}

function formatPattern(type){

  const labels={
    PERSISTENT_DECLINE:"Persistent decline",
    ACCELERATING_DECLINE:"Accelerating decline",
    MOBILITY_DETERIORATION:"Mobility deterioration",
    MULTI_SIGNAL_CONVERGENCE:"Multi-signal convergence"
  };

  return labels[type] || type;
}

function formatKey(key){

  const labels={
    baseline:"Baseline",
    current:"Current",
    changePercent:"Change",
    decliningSteps:"Declining steps",
    observations:"Observations",
    rankChange:"Rank change",
    signalCount:"Signal count",
    metrics:"Metrics",
    earlyAverageChange:"Early avg. change",
    recentAverageChange:"Recent avg. change"
  };

  return labels[key] || key;
}

function render(data){

  document.getElementById("loading").classList.add("hidden");
  document.getElementById("error").classList.add("hidden");

  const result=document.getElementById("result");
  result.classList.remove("hidden");

  const level=data.warningLevel || "UNKNOWN";

  const levelBox=document.getElementById("warningLevel");

  levelBox.textContent=level;
  levelBox.className="level " + level;

  document.getElementById("confidence").textContent=
    data.confidence === null || data.confidence === undefined
      ? "—"
      : Math.round(data.confidence*100) + "%";

  document.getElementById("patternCount").textContent=
    data.patternCount ?? (data.patterns || []).length;

  document.getElementById("metricsAffected").textContent=
    (data.metricsAffected || []).length;

  document.getElementById("dataPoints").textContent=
    data.dataPoints ?? "—";

  if(data.period){
    document.getElementById("period").textContent=
      `${data.period.from} → ${data.period.to}`;
  }

  document.getElementById("reviewStatus").textContent=
    data.humanReviewStatus || "PENDING";

  document.getElementById("recommendation").textContent=
    data.recommendation || "—";

  const container=document.getElementById("patterns");

  if(!data.patterns || data.patterns.length===0){

    container.innerHTML=`
      <div class="card">
        Không phát hiện early-warning pattern.
      </div>
    `;

  }else{

    container.innerHTML=
      data.patterns.map(renderPattern).join("");
  }
}

async function callEarlyWarning(observations){

  showLoading();

  try{

    const response=await fetch(
      "/api/ai/engines/health-trend/patterns",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          observations
        })
      }
    );

    if(!response.ok){

      throw new Error(
        `API returned HTTP ${response.status}`
      );
    }

    const data=await response.json();

    render(data);

  }catch(error){

    console.error(error);

    showError(
      "Không thể kết nối Early Warning API. " +
      "Hãy kiểm tra API V7.4.1 và Nginx proxy."
    );
  }
}

function loadEarlyWarning(){
  callEarlyWarning(DEMO_OBSERVATIONS);
}

function loadDemo(){
  callEarlyWarning(DEMO_OBSERVATIONS);
}

loadEarlyWarning();

</script>

</body>
</html>
