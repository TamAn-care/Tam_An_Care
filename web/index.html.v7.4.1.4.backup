<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tâm An Care — Early Warning</title>

<style>
:root{
  --green:#176b52;
  --green2:#238b6c;
  --green-light:#eaf6f1;
  --ink:#17332a;
  --muted:#66756f;
  --line:#dfe9e4;
  --bg:#f5f8f6;
  --white:#fff;
  --red:#c62828;
  --red-bg:#fff0f0;
  --orange:#c77800;
  --orange-bg:#fff7e8;
  --yellow:#9a7600;
  --yellow-bg:#fffbea;
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  background:var(--bg);
  color:var(--ink);
}

header{
  background:var(--green);
  color:white;
  padding:16px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:20;
}

.brand{
  font-size:20px;
  font-weight:800;
}

.subtitle{
  font-size:12px;
  opacity:.8;
  margin-top:3px;
}

.header-status{
  font-size:12px;
  background:#ffffff20;
  padding:7px 10px;
  border-radius:20px;
}

main{
  max-width:1200px;
  margin:auto;
  padding:22px;
}

.page-title{
  margin-bottom:18px;
}

.page-title h1{
  margin:0;
  font-size:27px;
}

.page-title p{
  margin:6px 0 0;
  color:var(--muted);
}

.toolbar{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:18px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 16px;
  cursor:pointer;
  font-weight:700;
}

.primary{
  background:var(--green);
  color:white;
}

.secondary{
  background:white;
  border:1px solid var(--line);
  color:var(--ink);
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:20px;
  box-shadow:0 4px 18px #17332a0b;
}

.early-warning{
  border-left:6px solid var(--red);
}

.warning-header{
  display:flex;
  justify-content:space-between;
  gap:15px;
  align-items:flex-start;
  flex-wrap:wrap;
}

.warning-title{
  font-size:18px;
  font-weight:800;
}

.warning-subtitle{
  color:var(--muted);
  font-size:13px;
  margin-top:4px;
}

.level{
  padding:9px 18px;
  border-radius:999px;
  font-size:14px;
  font-weight:900;
}

.level.HIGH{
  color:var(--red);
  background:var(--red-bg);
}

.level.MODERATE{
  color:var(--orange);
  background:var(--orange-bg);
}

.level.LOW{
  color:var(--yellow);
  background:var(--yellow-bg);
}

.level.NONE{
  color:var(--green);
  background:var(--green-light);
}

.level.UNKNOWN{
  color:#777;
  background:#f1f1f1;
}

.summary-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin:18px 0;
}

.metric-card{
  border:1px solid var(--line);
  border-radius:11px;
  padding:14px;
}

.metric-label{
  font-size:12px;
  color:var(--muted);
}

.metric-value{
  margin-top:5px;
  font-size:22px;
  font-weight:800;
}

.review-banner{
  margin:18px 0;
  padding:15px;
  border-radius:11px;
  background:#fff4e5;
  border:1px solid #f0d19e;
  color:#704600;
  display:flex;
  align-items:center;
  gap:12px;
}

.review-icon{
  font-size:23px;
}

.patterns{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.pattern{
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
  background:white;
}

.pattern-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
}

.pattern-type{
  font-weight:800;
}

.badge{
  font-size:11px;
  font-weight:900;
  padding:5px 9px;
  border-radius:20px;
}

.badge.HIGH{
  background:var(--red-bg);
  color:var(--red);
}

.badge.MODERATE{
  background:var(--orange-bg);
  color:var(--orange);
}

.badge.LOW{
  background:var(--yellow-bg);
  color:var(--yellow);
}

.pattern-message{
  color:var(--muted);
  font-size:13px;
  margin:10px 0;
}

.evidence{
  background:#f7faf8;
  border-radius:8px;
  padding:10px;
  font-size:12px;
}

.evidence-row{
  display:flex;
  justify-content:space-between;
  padding:3px 0;
}

.section-title{
  margin:26px 0 12px;
  font-size:17px;
}

.footer-note{
  margin-top:20px;
  color:var(--muted);
  font-size:11px;
  line-height:1.6;
}

.loading{
  text-align:center;
  padding:40px;
  color:var(--muted);
}

.error{
  background:var(--red-bg);
  border:1px solid #f1bcbc;
  color:var(--red);
  padding:15px;
  border-radius:10px;
}

.hidden{
  display:none;
}

@media(max-width:800px){
  main{
    padding:14px;
  }

  .summary-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .patterns{
    grid-template-columns:1fr;
  }
}

@media(max-width:520px){
  header{
    padding:13px 14px;
  }

  .brand{
    font-size:17px;
  }

  .header-status{
    display:none;
  }

  .page-title h1{
    font-size:22px;
  }

  .summary-grid{
    grid-template-columns:1fr 1fr;
  }

  .metric-value{
    font-size:18px;
  }

  .warning-header{
    flex-direction:column;
  }
}

/* =========================================================
   V7.4.1.3-A — CARE TEAM REVIEW WORKFLOW
   UI-only state; backend API remains unchanged.
   ========================================================= */

.review-meta{
  margin-top:10px;
  font-size:13px;
  color:#64748b;
}

.review-meta-label{
  font-weight:600;
  margin-right:6px;
}

.review-actions{
  display:flex;
  gap:10px;
  margin-top:14px;
  flex-wrap:wrap;
}

.review-button{
  border:0;
  border-radius:8px;
  padding:9px 15px;
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  transition:opacity .15s ease, transform .15s ease;
}

.review-button:hover{
  opacity:.9;
}

.review-button:active{
  transform:translateY(1px);
}

.review-button.acknowledge{
  background:#166534;
  color:#fff;
}

.review-button.reset{
  background:#64748b;
  color:#fff;
}

.review-status.ACKNOWLEDGED{
  color:#166534;
  font-weight:700;
}

.review-status.PENDING{
  color:#b45309;
  font-weight:700;
}

.hidden{
  display:none !important;
}


.audit-governance{
  margin-top:16px;
  padding:16px;
  border:1px solid #d8dee8;
  border-radius:12px;
  background:#f8fafc;
}

.audit-governance-header{
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-bottom:14px;
}

.audit-governance-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  width:28px;
  height:28px;
  border-radius:50%;
  background:#e8f5ee;
  color:#16734a;
  font-weight:700;
}

.audit-governance-subtitle{
  margin-top:3px;
  font-size:12px;
  color:#64748b;
}

.audit-governance-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10px;
}

.audit-item{
  padding:10px;
  border-radius:8px;
  background:#fff;
  border:1px solid #e5e7eb;
}

.audit-label{
  display:block;
  font-size:11px;
  color:#64748b;
  margin-bottom:5px;
}

.audit-value{
  display:inline-block;
  font-size:12px;
  font-weight:700;
  color:#334155;
}

.audit-governance-note{
  margin-top:12px;
  padding:10px 12px;
  border-left:3px solid #94a3b8;
  background:#fff;
  color:#475569;
  font-size:12px;
  line-height:1.5;
}

@media (max-width:700px){
  .audit-governance-grid{
    grid-template-columns:1fr 1fr;
  }
}

@media (max-width:480px){
  .audit-governance-grid{
    grid-template-columns:1fr;
  }
}

</style>

<style>

.severity-filter{
  margin:20px 0;
  padding:16px;
  border-radius:12px;
  background:#f7f9f8;
  border:1px solid #e2e8e5;
}

.filter-label{
  font-size:13px;
  font-weight:600;
  margin-bottom:10px;
  color:#52605a;
}

.filter-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.filter-button{
  border:1px solid #d5ddd9;
  background:white;
  border-radius:20px;
  padding:7px 14px;
  font-size:12px;
  font-weight:600;
  cursor:pointer;
}

.filter-button:hover{
  transform:translateY(-1px);
}

.filter-button.active{
  box-shadow:0 0 0 2px rgba(40,80,60,.12);
}

.filter-button.HIGH{
  color:#a32020;
}

.filter-button.MODERATE{
  color:#996400;
}

.filter-button.LOW{
  color:#2e6b45;
}

.pattern-card{
  margin:12px 0;
  border:1px solid #e0e6e3;
  border-radius:12px;
  overflow:hidden;
  background:#fff;
}

.pattern-header{
  width:100%;
  display:flex;
  align-items:center;
  gap:12px;
  padding:15px;
  border:0;
  background:transparent;
  cursor:pointer;
  text-align:left;
}

.pattern-header:hover{
  background:#f8faf9;
}

.pattern-toggle{
  width:18px;
  flex:0 0 18px;
  color:#65736c;
}

.pattern-main{
  flex:1;
  min-width:0;
}

.pattern-title{
  display:block;
  font-weight:700;
  margin-bottom:4px;
}

.pattern-message{
  display:block;
  font-size:13px;
  color:#65736c;
}

.pattern-severity{
  flex:0 0 auto;
  border-radius:20px;
  padding:5px 10px;
  font-size:11px;
  font-weight:700;
}

.pattern-severity.HIGH{
  background:#fde8e8;
  color:#a32020;
}

.pattern-severity.MODERATE{
  background:#fff3d6;
  color:#996400;
}

.pattern-severity.LOW{
  background:#e7f4eb;
  color:#2e6b45;
}

.pattern-details{
  padding:0 16px 16px 46px;
  border-top:1px solid #edf1ef;
}

.pattern-metrics{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin:12px 0;
}

.metric-chip{
  display:inline-block;
  padding:4px 8px;
  border-radius:12px;
  background:#eef3f0;
  color:#53615b;
  font-size:11px;
}

.evidence-title{
  font-size:13px;
  font-weight:700;
  margin:12px 0 7px;
}

.evidence-box{
  border:1px solid #e3e8e5;
  border-radius:8px;
  overflow:hidden;
  background:#fafcfb;
}

.evidence-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:8px 10px;
  border-bottom:1px solid #edf0ee;
  font-size:12px;
}

.evidence-row:last-child{
  border-bottom:0;
}

.evidence-key{
  color:#64716b;
}

.evidence-value{
  font-weight:600;
  text-align:right;
  word-break:break-word;
}

.evidence-empty{
  padding:12px;
  color:#7b8680;
  font-size:12px;
}

.human-review-panel{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin:20px 0;
  padding:16px;
  border-radius:12px;
  border:1px solid #ead9a8;
  background:#fffaf0;
}

.human-review-content{
  display:flex;
  align-items:center;
  gap:12px;
}

.human-review-icon{
  width:32px;
  height:32px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  background:#f1c75b;
  color:#604600;
}

.human-review-title{
  font-weight:800;
  color:#634b00;
}

.human-review-subtitle{
  margin-top:3px;
  font-size:12px;
  color:#756846;
}

.human-review-action{
  display:flex;
  align-items:center;
  gap:10px;
}

.review-status{
  font-size:11px;
  font-weight:800;
  padding:5px 9px;
  border-radius:12px;
  background:#fff0cf;
  color:#8b6200;
}

.review-status.ACKNOWLEDGED{
  background:#e5f4e9;
  color:#28643c;
}

.acknowledge-button{
  border:0;
  border-radius:8px;
  padding:9px 13px;
  background:#315f46;
  color:white;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
}

.acknowledge-button:hover{
  opacity:.9;
}

.acknowledge-button:disabled{
  cursor:default;
  opacity:.75;
}

.acknowledge-button.acknowledged{
  background:#4b8060;
}

.empty-filter{
  padding:20px;
  text-align:center;
  color:#69756f;
}

@media(max-width:700px){

  .human-review-panel{
    flex-direction:column;
    align-items:stretch;
  }

  .human-review-action{
    justify-content:space-between;
  }

  .pattern-header{
    align-items:flex-start;
  }

  .pattern-severity{
    margin-left:auto;
  }

  .pattern-details{
    padding-left:16px;
  }

  .evidence-row{
    flex-direction:column;
    gap:3px;
  }

  .evidence-value{
    text-align:left;
  }
}

</style>

</head>

<body>

<header>
  <div>
    <div class="brand">TÂM AN CARE</div>
    <div class="subtitle">Health Trend AI • Early Warning Dashboard</div>
  </div>

  <div class="header-status">
    V7.4.1.1 • Human-in-the-loop
  </div>
</header>

<main>

  <div class="page-title">
    <h1>Early Warning — Health Trend</h1>
    <p>Phát hiện các xu hướng sức khỏe cần nhân viên chăm sóc xem xét.</p>
  </div>

  <div class="toolbar">
    <button class="primary" onclick="loadEarlyWarning()">
      ↻ Phân tích lại
    </button>

    <button class="secondary" onclick="loadDemo()">
      Dữ liệu Demo
    </button>
  </div>

  <div id="loading" class="card loading">
    Đang tải phân tích Early Warning...
  </div>

  <div id="error" class="error hidden"></div>

  <section id="result" class="card early-warning hidden">

    <div class="warning-header">

      <div>
        <div class="warning-title">
          Health Trend Early Warning
        </div>

        <div class="warning-subtitle" id="period">
          —
        </div>
      </div>

      <div id="warningLevel" class="level UNKNOWN">
        UNKNOWN
      </div>

    </div>

    <div class="summary-grid">

      <div class="metric-card">
        <div class="metric-label">Confidence</div>
        <div class="metric-value" id="confidence">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Patterns</div>
        <div class="metric-value" id="patternCount">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Health domains</div>
        <div class="metric-value" id="metricsAffected">—</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Data points</div>
        <div class="metric-value" id="dataPoints">—</div>
      </div>

    </div>

    <div class="review-banner">
      <div class="review-icon">⚠</div>

      <div>
        <strong>HUMAN REVIEW REQUIRED</strong>
        <div id="reviewStatus">
          PENDING
        </div>

        <div class="review-meta">
          <div>
            <span class="review-meta-label">
              Review timestamp
            </span>
            <span id="reviewTimestamp">—</span>
          </div>
        </div>

        
        <div id="auditGovernance" class="audit-governance">

          <div class="audit-governance-header">
            <span class="audit-governance-icon">✓</span>
            <div>
              <strong>REVIEW &amp; AUDIT GOVERNANCE</strong>
              <div class="audit-governance-subtitle">
                AI warning detection requires human care-team review.
              </div>
            </div>
          </div>

          <div class="audit-governance-grid">

            <div class="audit-item">
              <span class="audit-label">AI detection</span>
              <span id="auditDetectionStatus"
                    class="audit-value">
                DETECTED
              </span>
            </div>

            <div class="audit-item">
              <span class="audit-label">Human review</span>
              <span id="auditHumanReviewStatus"
                    class="audit-value">
                REQUIRED
              </span>
            </div>

            <div class="audit-item">
              <span class="audit-label">Audit requirement</span>
              <span id="auditRequiredStatus"
                    class="audit-value">
                REQUIRED
              </span>
            </div>

            <div class="audit-item">
              <span class="audit-label">Autonomous clinical action</span>
              <span id="auditAutonomousStatus"
                    class="audit-value">
                NOT PERFORMED
              </span>
            </div>

          </div>

          <div class="audit-governance-note">
            <strong>Important:</strong>
            Acknowledgement confirms that the care team has reviewed
            the warning. It does not confirm a diagnosis or authorize
            autonomous clinical action.
          </div>

        </div>

<div class="review-actions">

          <button
            id="acknowledgeReviewButton"
            class="review-button acknowledge"
            type="button"
            onclick="acknowledgeReview()">
            Acknowledge Review
          </button>

          <button
            id="resetReviewButton"
            class="review-button reset hidden"
            type="button"
            onclick="resetReview()">
            Reset to Pending
          </button>

        </div>
      </div>
    </div>

    <div class="section-title">
      Warning Patterns
    </div>

    <div id="patterns" class="patterns"></div>

    <div class="section-title">
      Recommendation
    </div>

    <div class="card">
      <div id="recommendation">—</div>
    </div>

    <div class="footer-note">
      Đây là công cụ hỗ trợ phát hiện xu hướng dựa trên rules engine.
      Kết quả không thay thế đánh giá chuyên môn của nhân viên chăm sóc
      hoặc cán bộ y tế. Không thực hiện autonomous clinical action.
    </div>

  </section>

</main>


<script>

const DEMO_OBSERVATIONS = [
  {
    date:"2026-07-18",
    weightKg:63,
    foodFluidIntakePercent:72,
    sleepHours:7,
    spo2:97,
    mobility:"ASSISTED"
  },
  {
    date:"2026-07-25",
    weightKg:62.1,
    foodFluidIntakePercent:68,
    sleepHours:6.2,
    spo2:96,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-01",
    weightKg:61,
    foodFluidIntakePercent:63,
    sleepHours:5.2,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-08",
    weightKg:60.4,
    foodFluidIntakePercent:59,
    sleepHours:4.9,
    spo2:94,
    mobility:"ASSISTED"
  },
  {
    date:"2026-08-15",
    weightKg:59.8,
    foodFluidIntakePercent:55,
    sleepHours:4.5,
    spo2:93,
    mobility:"HIGH_ASSISTANCE"
  }
];

let currentAnalysis = null;
let activeSeverityFilter = "ALL";
let expandedPatterns = new Set();

const ACK_PREFIX = "taman-care-v7.4.1.2-ack-";

function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}

function formatPatternType(type){

  const labels = {

    PERSISTENT_DECLINE:
      "Persistent decline",

    ACCELERATING_DECLINE:
      "Accelerating decline",

    MOBILITY_DETERIORATION:
      "Mobility deterioration",

    MULTI_SIGNAL_CONVERGENCE:
      "Multi-signal convergence"

  };

  return labels[type] || String(type || "Unknown pattern");

}

function formatMetric(metric){

  const labels = {

    weightKg:"Weight",

    foodFluidIntakePercent:"Food / fluid intake",

    sleepHours:"Sleep duration",

    spo2:"SpO₂",

    mobility:"Mobility"

  };

  return labels[metric] || metric;

}

function formatSeverity(severity){

  const labels = {

    HIGH:"High",

    MODERATE:"Moderate",

    LOW:"Low",

    UNKNOWN:"Unknown"

  };

  return labels[severity] || severity || "Unknown";

}

function formatKey(key){

  const labels = {

    baseline:"Baseline",

    current:"Current",

    changePercent:"Change",

    decliningSteps:"Declining steps",

    observations:"Observations",

    rankChange:"Rank change",

    signalCount:"Signal count",

    metrics:"Metrics",

    earlyAverageChange:"Early avg. change",

    recentAverageChange:"Recent avg. change"

  };

  return labels[key] || key;

}

function formatEvidenceValue(key,value){

  if(value === null || value === undefined){

    return "—";

  }

  if(key === "changePercent"){

    const n = Number(value);

    if(Number.isFinite(n)){

      return `${n.toFixed(2)}%`;

    }

  }

  if(Array.isArray(value)){

    return value.map(v => formatMetric(v)).join(", ");

  }

  return String(value);

}

function acknowledgementKey(patternId){

  return ACK_PREFIX + patternId;

}

function isAcknowledged(patternId){

  return localStorage.getItem(
    acknowledgementKey(patternId)
  ) === "ACKNOWLEDGED";

}

function acknowledgePattern(patternId){

  localStorage.setItem(
    acknowledgementKey(patternId),
    "ACKNOWLEDGED"
  );

  renderPatterns();

}

function clearAcknowledgement(patternId){

  localStorage.removeItem(
    acknowledgementKey(patternId)
  );

  renderPatterns();

}

function togglePattern(patternId){

  if(expandedPatterns.has(patternId)){

    expandedPatterns.delete(patternId);

  }else{

    expandedPatterns.add(patternId);

  }

  renderPatterns();

}

function injectInteractionStyles(){

  if(document.getElementById("v7412Styles")){

    return;

  }

  const style = document.createElement("style");

  style.id = "v7412Styles";

  style.textContent = `

    .v7412-toolbar{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:16px 0;
      align-items:center;
    }

    .v7412-filter{
      border:1px solid #d7dde5;
      background:#fff;
      border-radius:8px;
      padding:8px 14px;
      cursor:pointer;
      font-weight:600;
    }

    .v7412-filter.active{
      border-color:#2563eb;
      background:#eff6ff;
      color:#1d4ed8;
    }

    .v7412-filter.high.active{
      border-color:#dc2626;
      background:#fef2f2;
      color:#b91c1c;
    }

    .v7412-filter.moderate.active{
      border-color:#d97706;
      background:#fffbeb;
      color:#b45309;
    }

    .v7412-filter.low.active{
      border-color:#16a34a;
      background:#f0fdf4;
      color:#15803d;
    }

    .v7412-pattern{
      border:1px solid #e2e8f0;
      border-radius:12px;
      margin:12px 0;
      overflow:hidden;
      background:#fff;
    }

    .v7412-pattern-header{
      padding:14px;
      cursor:pointer;
    }

    .v7412-pattern-header:hover{
      background:#f8fafc;
    }

    .v7412-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }

    .v7412-title{
      font-weight:700;
    }

    .v7412-message{
      margin-top:7px;
      color:#475569;
    }

    .v7412-severity{
      display:inline-block;
      border-radius:999px;
      padding:4px 9px;
      font-size:12px;
      font-weight:700;
    }

    .v7412-severity.HIGH{
      background:#fee2e2;
      color:#b91c1c;
    }

    .v7412-severity.MODERATE{
      background:#fef3c7;
      color:#b45309;
    }

    .v7412-severity.LOW{
      background:#dcfce7;
      color:#15803d;
    }

    .v7412-evidence{
      border-top:1px solid #e2e8f0;
      padding:14px;
      background:#f8fafc;
    }

    .v7412-evidence-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
      gap:8px;
      margin-top:10px;
    }

    .v7412-evidence-item{
      background:#fff;
      border:1px solid #e2e8f0;
      border-radius:8px;
      padding:9px;
    }

    .v7412-evidence-key{
      font-size:12px;
      color:#64748b;
    }

    .v7412-evidence-value{
      margin-top:3px;
      font-weight:600;
    }

    .v7412-actions{
      display:flex;
      gap:8px;
      margin-top:14px;
      flex-wrap:wrap;
    }

    .v7412-button{
      border:1px solid #cbd5e1;
      background:#fff;
      border-radius:8px;
      padding:8px 12px;
      cursor:pointer;
      font-weight:600;
    }

    .v7412-button.ack{
      background:#166534;
      color:#fff;
      border-color:#166534;
    }

    .v7412-ack{
      color:#166534;
      font-weight:700;
    }

    .v7412-review-banner{
      margin:14px 0;
      padding:12px 14px;
      border-radius:10px;
      background:#fff7ed;
      border:1px solid #fdba74;
      color:#9a3412;
      font-weight:600;
    }

    .v7412-count{
      margin-left:auto;
      color:#64748b;
      font-size:13px;
    }

  `;

  document.head.appendChild(style);

}

function ensureFilterBar(){

  const container = document.getElementById("patterns");

  if(!container){

    return;

  }

  let toolbar = document.getElementById("v7412Toolbar");

  if(toolbar){

    return;

  }

  toolbar = document.createElement("div");

  toolbar.id = "v7412Toolbar";

  toolbar.className = "v7412-toolbar";

  toolbar.innerHTML = `

    <button
      class="v7412-filter active"
      data-severity="ALL"
      onclick="setSeverityFilter('ALL')">
      All
    </button>

    <button
      class="v7412-filter high"
      data-severity="HIGH"
      onclick="setSeverityFilter('HIGH')">
      HIGH
    </button>

    <button
      class="v7412-filter moderate"
      data-severity="MODERATE"
      onclick="setSeverityFilter('MODERATE')">
      MODERATE
    </button>

    <button
      class="v7412-filter low"
      data-severity="LOW"
      onclick="setSeverityFilter('LOW')">
      LOW
    </button>

    <span id="v7412FilterCount" class="v7412-count"></span>

  `;

  container.parentNode.insertBefore(toolbar,container);

}

function setSeverityFilter(severity){

  activeSeverityFilter = severity;

  document.querySelectorAll(
    ".v7412-filter"
  ).forEach(button => {

    button.classList.toggle(
      "active",
      button.dataset.severity === severity
    );

  });

  renderPatterns();

}

function renderEvidence(evidence){

  if(!evidence || typeof evidence !== "object"){

    return `
      <div class="v7412-evidence-item">
        <div class="v7412-evidence-value">No evidence available</div>
      </div>
    `;

  }

  return Object.entries(evidence)
    .map(([key,value]) => `

      <div class="v7412-evidence-item">

        <div class="v7412-evidence-key">
          ${escapeHtml(formatKey(key))}
        </div>

        <div class="v7412-evidence-value">
          ${escapeHtml(formatEvidenceValue(key,value))}
        </div>

      </div>

    `)
    .join("");

}

function renderPattern(pattern){

  const patternId = pattern.patternId || crypto.randomUUID();

  const severity = pattern.severity || "UNKNOWN";

  const expanded =
    expandedPatterns.has(patternId);

  const acknowledged =
    isAcknowledged(patternId);

  const metrics =
    (pattern.metrics || [])
      .map(formatMetric)
      .join(", ");

  return `

    <article
      class="v7412-pattern"
      data-pattern-id="${escapeHtml(patternId)}"
      data-severity="${escapeHtml(severity)}">

      <div
        class="v7412-pattern-header"
        onclick="togglePattern('${escapeHtml(patternId)}')">

        <div class="v7412-row">

          <div>

            <div class="v7412-title">
              ${escapeHtml(formatPatternType(pattern.type))}
            </div>

            <div class="v7412-message">
              ${escapeHtml(pattern.message || "—")}
            </div>

          </div>

          <div>

            <span class="v7412-severity ${escapeHtml(severity)}">
              ${escapeHtml(formatSeverity(severity))}
            </span>

          </div>

        </div>

        <div class="v7412-message">
          Metrics: ${escapeHtml(metrics || "—")}
        </div>

      </div>

      ${
        expanded
        ? `

          <div class="v7412-evidence">

            <strong>Evidence</strong>

            <div class="v7412-evidence-grid">
              ${renderEvidence(pattern.evidence)}
            </div>

            <div class="v7412-actions">

              ${
                acknowledged

                ? `

                  <span class="v7412-ack">
                    ✓ Acknowledged by care staff
                  </span>

                  <button
                    class="v7412-button"
                    onclick="
                      event.stopPropagation();
                      clearAcknowledgement('${escapeHtml(patternId)}')
                    ">
                    Undo acknowledgement
                  </button>

                `

                : `

                  <button
                    class="v7412-button ack"
                    onclick="
                      event.stopPropagation();
                      acknowledgePattern('${escapeHtml(patternId)}')
                    ">
                    Acknowledge
                  </button>

                `
              }

            </div>

          </div>

        `
        : ""
      }

    </article>

  `;

}

function renderPatterns(){

  const container =
    document.getElementById("patterns");

  if(!container || !currentAnalysis){

    return;

  }

  const patterns =
    currentAnalysis.patterns || [];

  const filtered =
    activeSeverityFilter === "ALL"

      ? patterns

      : patterns.filter(
          pattern =>
            pattern.severity === activeSeverityFilter
        );

  const count =
    document.getElementById("v7412FilterCount");

  if(count){

    count.textContent =
      `${filtered.length} of ${patterns.length} patterns`;

  }

  if(filtered.length === 0){

    container.innerHTML = `

      <div class="card">

        No patterns match the selected severity filter.

      </div>

    `;

    ensureFilterBar();

    return;

  }

  container.innerHTML =
    filtered.map(renderPattern).join("");

  ensureFilterBar();

}


function getReviewState(){
  return localStorage.getItem("tamanCareEarlyWarningReview") || "PENDING";
}

function getReviewTimestamp(){
  return localStorage.getItem("tamanCareEarlyWarningReviewTimestamp") || "";
}

function acknowledgeReview(){

  localStorage.setItem(
    "tamanCareEarlyWarningReview",
    "ACKNOWLEDGED"
  );

  localStorage.setItem(
    "tamanCareEarlyWarningReviewTimestamp",
    new Date().toISOString()
  );

  renderReviewWorkflow();

}

function resetReview(){

  localStorage.setItem(
    "tamanCareEarlyWarningReview",
    "PENDING"
  );

  localStorage.removeItem(
    "tamanCareEarlyWarningReviewTimestamp"
  );

  renderReviewWorkflow();

}

function formatReviewTimestamp(timestamp){

  if(!timestamp){
    return "—";
  }

  try{

    return new Intl.DateTimeFormat(
      "vi-VN",
      {
        dateStyle:"short",
        timeStyle:"medium"
      }
    ).format(new Date(timestamp));

  }catch(error){

    return timestamp;

  }
}

function renderReviewWorkflow(){

  const status = getReviewState();

  const timestamp = getReviewTimestamp();

  const statusElement =
    document.getElementById("reviewStatus");

  const timestampElement =
    document.getElementById("reviewTimestamp");

  const acknowledgeButton =
    document.getElementById("acknowledgeReviewButton");

  const resetButton =
    document.getElementById("resetReviewButton");

  if(statusElement){

    statusElement.textContent = status;

    statusElement.className =
      "review-status " + status;

  }

  if(timestampElement){

    timestampElement.textContent =
      status === "ACKNOWLEDGED"
        ? formatReviewTimestamp(timestamp)
        : "—";

  }

  if(acknowledgeButton){

    acknowledgeButton.classList.toggle(
      "hidden",
      status === "ACKNOWLEDGED"
    );

  }

  if(resetButton){

    resetButton.classList.toggle(
      "hidden",
      status !== "ACKNOWLEDGED"
    );

  }

}


function render(data){

  document
    .getElementById("loading")
    .classList.add("hidden");

  document
    .getElementById("error")
    .classList.add("hidden");

  const result =
    document.getElementById("result");

  result.classList.remove("hidden");

  currentAnalysis = data;

  const level =
    data.warningLevel || "UNKNOWN";

  const levelBox =
    document.getElementById("warningLevel");

  levelBox.textContent = level;

  levelBox.className =
    "level " + level;

  document.getElementById("confidence").textContent =
    data.confidence === null ||
    data.confidence === undefined

      ? "—"

      : Math.round(data.confidence * 100) + "%";

  document.getElementById("patternCount").textContent =
    data.patternCount ??
    (data.patterns || []).length;

  document.getElementById("metricsAffected").textContent =
    (data.metricsAffected || []).length;

  document.getElementById("dataPoints").textContent =
    data.dataPoints ?? "—";

  if(data.period){

    document.getElementById("period").textContent =
      `${data.period.from} → ${data.period.to}`;

  }

  const apiReviewStatus =
    data.humanReviewStatus || "PENDING";

  if(!localStorage.getItem("tamanCareEarlyWarningReview")){

    localStorage.setItem(
      "tamanCareEarlyWarningReview",
      apiReviewStatus
    );

  }


  const auditRequired =
    data.audit && data.audit.required === true;

  const humanReviewRequired =
    data.humanReviewRequired === true;

  const autonomousClinicalAction =
    data.autonomousClinicalAction === true;

  const auditRequiredElement =
    document.getElementById("auditRequiredStatus");

  const auditHumanElement =
    document.getElementById("auditHumanReviewStatus");

  const auditAutonomousElement =
    document.getElementById("auditAutonomousStatus");

  if(auditRequiredElement){
    auditRequiredElement.textContent =
      auditRequired ? "REQUIRED" : "NOT REQUIRED";
  }

  if(auditHumanElement){
    auditHumanElement.textContent =
      humanReviewRequired ? "REQUIRED" : "NOT REQUIRED";
  }

  if(auditAutonomousElement){
    auditAutonomousElement.textContent =
      autonomousClinicalAction
        ? "PERFORMED"
        : "NOT PERFORMED";
  }

  renderReviewWorkflow();

  document.getElementById("recommendation").textContent =
    data.recommendation || "—";

  const resultElement =
    document.getElementById("result");

  let reviewBanner =
    document.getElementById("v7412ReviewBanner");

  if(data.humanReviewRequired){

    if(!reviewBanner){

      reviewBanner =
        document.createElement("div");

      reviewBanner.id =
        "v7412ReviewBanner";

      reviewBanner.className =
        "v7412-review-banner";

      resultElement.prepend(reviewBanner);

    }

    reviewBanner.textContent =
      "Human Review Required — Care-team review is required for this early-warning result.";

  }else if(reviewBanner){

    reviewBanner.remove();

  }

  injectInteractionStyles();

  ensureFilterBar();

  renderPatterns();

}

function showLoading(){

  document
    .getElementById("loading")
    .classList.remove("hidden");

  document
    .getElementById("error")
    .classList.add("hidden");

}

function showError(message){

  document
    .getElementById("loading")
    .classList.add("hidden");

  const error =
    document.getElementById("error");

  error.textContent = message;

  error.classList.remove("hidden");

}

async function callEarlyWarning(observations){

  showLoading();

  try{

    const response =
      await fetch(
        "/api/ai/engines/health-trend/patterns",
        {
          method:"POST",
          headers:{
            "Content-Type":"application/json"
          },
          body:JSON.stringify({
            observations
          })
        }
      );

    if(!response.ok){

      throw new Error(
        `API returned HTTP ${response.status}`
      );

    }

    const data =
      await response.json();

    render(data);

  }catch(error){

    console.error(
      "Early Warning API error:",
      error
    );

    showError(
      "Không thể kết nối Early Warning API. " +
      "Hãy kiểm tra API V7.4.1 và Nginx proxy."
    );

  }

}

function loadEarlyWarning(){

  callEarlyWarning(
    DEMO_OBSERVATIONS
  );

}

function loadDemo(){

  callEarlyWarning(
    DEMO_OBSERVATIONS
  );

}

loadEarlyWarning();

</script>


</body>
</html>
