import { Injectable, BadRequestException } from '@nestjs/common';

export const ENGINES = [
 {engineId:'risk',name:'Risk AI',riskClass:'B',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'health-trend',name:'Health Trend AI',riskClass:'B',status:'ACTIVE_LONGITUDINAL_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'staffing',name:'Staffing AI',riskClass:'A',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'workload',name:'Workload AI',riskClass:'A',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'kpi',name:'KPI AI',riskClass:'A',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'anomaly',name:'Anomaly AI',riskClass:'B',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false},
 {engineId:'quality',name:'Quality AI',riskClass:'B',status:'ACTIVE_RULES_ENGINE',modelProvider:'internal-rules',productionEnabled:false}
] as const;

type Obs={date:string;weightKg?:number;foodFluidIntakePercent?:number;sleepHours?:number;spo2?:number;mobility?:string};
const n=(x:any)=>typeof x==='number'&&Number.isFinite(x)?x:undefined;
const pct=(a:number,b:number)=>a===0?0:(b-a)/a*100;

@Injectable()
export class AiEngineService {
  list(){return ENGINES;}
  meta(id:string){const m=ENGINES.find(x=>x.engineId===id); if(!m) throw new BadRequestException('Unknown engine'); return m;}
  analyze(id:string,data:any){
    const m=this.meta(id);
    if(id==='health-trend') return this.healthTrend(data);
    return {engine:id,trend:'NOT_IMPLEMENTED_IN_7.3.2',confidence:null,evidence:[],recommendation:'Engine retained as V7.3.1 rules foundation.'};
  }
  healthTrend(data:any){
    const series:Obs[] = Array.isArray(data?.observations) ? data.observations : Array.isArray(data?.longitudinalObservations) ? data.longitudinalObservations : [];
    if(series.length<3) return {engine:'health-trend',trend:'INSUFFICIENT_DATA',confidence:null,evidence:[],dataPoints:series.length,minDataPoints:3,recommendation:'Collect at least 3 dated observations before trend interpretation.'};
    const sorted=[...series].filter(x=>x&&typeof x.date==='string').sort((a,b)=>a.date.localeCompare(b.date));
    if(sorted.length<3) return {engine:'health-trend',trend:'INSUFFICIENT_DATA',confidence:null,evidence:[],dataPoints:sorted.length,minDataPoints:3,recommendation:'At least 3 valid dated observations are required.'};
    const first=sorted[0], last=sorted[sorted.length-1];
    const evidence:any[]=[]; let deterioration=0, improvement=0;
    const add=(metric:string,a:any,b:any,severity:string)=>{const av=n(a),bv=n(b); if(av===undefined||bv===undefined) return; const change=pct(av,bv); if(Math.abs(change)<2) return; const direction=change<0?'DOWN':'UP'; evidence.push({metric,direction,baseline:av,current:bv,changePercent:Number(change.toFixed(2)),severity});};
    const w0=n(first.weightKg),w1=n(last.weightKg); if(w0!==undefined&&w1!==undefined){const c=pct(w0,w1); if(c<=-5){deterioration+=2;add('weightKg',w0,w1,'HIGH');} else if(c< -2){deterioration++;add('weightKg',w0,w1,'MODERATE');} else if(c>=2){improvement++;add('weightKg',w0,w1,'POSITIVE');}}
    const i0=n(first.foodFluidIntakePercent),i1=n(last.foodFluidIntakePercent); if(i0!==undefined&&i1!==undefined){const c=pct(i0,i1); if(c<=-15){deterioration+=2;add('foodFluidIntakePercent',i0,i1,'HIGH');} else if(c< -5){deterioration++;add('foodFluidIntakePercent',i0,i1,'MODERATE');} else if(c>=5){improvement++;add('foodFluidIntakePercent',i0,i1,'POSITIVE');}}
    const s0=n(first.sleepHours),s1=n(last.sleepHours); if(s0!==undefined&&s1!==undefined){const c=pct(s0,s1); if(c<=-20){deterioration++;add('sleepHours',s0,s1,'HIGH');} else if(c< -10){deterioration++;add('sleepHours',s0,s1,'MODERATE');} else if(c>=10){improvement++;add('sleepHours',s0,s1,'POSITIVE');}}
    const o0=n(first.spo2),o1=n(last.spo2); if(o0!==undefined&&o1!==undefined){const c=pct(o0,o1); if(c<=-3){deterioration+=2;add('spo2',o0,o1,'HIGH');} else if(c< -1){deterioration++;add('spo2',o0,o1,'MODERATE');} else if(c>=1){improvement++;add('spo2',o0,o1,'POSITIVE');}}
    if(first.mobility&&last.mobility&&first.mobility!==last.mobility){const rank=(x:string)=>x==='INDEPENDENT'?0:x==='SUPERVISION'?1:x==='ASSISTED'?2:x==='HIGH_ASSISTANCE'?3:4; const d=rank(last.mobility)-rank(first.mobility); evidence.push({metric:'mobility',direction:d>0?'WORSE':d<0?'BETTER':'UNCHANGED',baseline:first.mobility,current:last.mobility,severity:Math.abs(d)>=2?'HIGH':'MODERATE'}); if(d>0)deterioration+=d; else if(d<0)improvement+=Math.abs(d);}
    const trend=deterioration>=2?'DETERIORATING':improvement>=2&&deterioration===0?'IMPROVING':'STABLE';
    const confidence=Math.min(0.95,Number((0.55+Math.min(0.3,sorted.length*0.03)+Math.min(0.1,evidence.length*0.02)).toFixed(2)));
    const severity=deterioration>=4?'HIGH':deterioration>=2?'MODERATE':'LOW';
    return {engine:'health-trend',trend,overallSeverity:severity,confidence,evidence,dataPoints:sorted.length,period:{from:first.date,to:last.date},recommendation:trend==='DETERIORATING'?'Prioritize human care-team review and verify contributing observations.':trend==='IMPROVING'?'Continue monitoring and verify sustained improvement.':'Continue routine monitoring; reassess if new signals appear.'};
  }
  demoData(id:string){if(id==='health-trend') return {engineId:id,syntheticData:true,observations:[{date:'2026-07-18',weightKg:63,foodFluidIntakePercent:72,sleepHours:7,spo2:97,mobility:'ASSISTED'},{date:'2026-07-25',weightKg:62.1,foodFluidIntakePercent:68,sleepHours:6.2,spo2:96,mobility:'ASSISTED'},{date:'2026-08-01',weightKg:61,foodFluidIntakePercent:63,sleepHours:5.2,spo2:94,mobility:'ASSISTED'},{date:'2026-08-08',weightKg:60.4,foodFluidIntakePercent:59,sleepHours:4.9,spo2:94,mobility:'ASSISTED'},{date:'2026-08-15',weightKg:59.8,foodFluidIntakePercent:55,sleepHours:4.5,spo2:93,mobility:'HIGH_ASSISTANCE'}]}; return {engineId:id,syntheticData:true};}
}
