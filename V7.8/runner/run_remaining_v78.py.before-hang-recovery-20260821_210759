def require_file_hash(path, expected, label, gate):
    if not path.is_file():
        safe_stop(
            f"{label} missing: {path}",
            gate,
        )

    actual = sha(path)
    print(f"{label}_HASH={actual}")

    if actual != expected:
        safe_stop(
            f"{label} hash mismatch",
            gate,
        )


def inspect(name):
    r = run([
        "docker",
        "inspect",
        name,
    ])

    if r.returncode:
        return None

    try:
        return json.loads(r.stdout)[0]
    except Exception:
        return None


def container_state(info):
    if not info:
        return "<MISSING>"

    return info.get(
        "State", {}
    ).get(
        "Status",
        "<UNKNOWN>",
    )


def curl_code(url, method="GET", body=None):
    cmd = [
        "curl",
        "-sS",
        "--max-time", "5",
        "-o", "/dev/null",
        "-w", "%{http_code}",
    ]

    if method != "GET":
        cmd += [
            "-X", method,
        ]

    if body is not None:
        cmd += [
            "-H",
            "Content-Type: application/json",
            "--data",
            body,
        ]

    cmd.append(url)

    r = run(cmd)

    return r.stdout.strip()


