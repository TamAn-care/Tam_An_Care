def source_hash(root):
    ignored = {
        ".git",
        "node_modules",
        "dist",
        "build",
        "coverage",
    }

    allowed = {
        ".ts", ".tsx",
        ".js", ".jsx",
        ".json",
        ".sql",
        ".css",
        ".html",
        ".md",
        ".yml",
        ".yaml",
    }

    data = {}

    for p in root.rglob("*"):
        if not p.is_file():
            continue

        if any(
            part in ignored
            for part in p.parts
        ):
            continue

        if p.name.endswith(
            ".tsbuildinfo"
        ):
            continue

        if p.suffix.lower() not in allowed:
            continue

        data[
            str(p.relative_to(root))
        ] = sha(p)

    raw = json.dumps(
        data,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()

    return hashlib.sha256(
        raw
    ).hexdigest()


