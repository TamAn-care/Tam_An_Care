def prod_query(sql):
    r = run([
        "docker",
        "exec",
        DB_CONTAINER,
        "psql",
        "-X",
        "-v", "ON_ERROR_STOP=1",
        "-U", DB_USER,
        "-d", DB_NAME,
        "-At",
        "-c",
        "BEGIN READ ONLY;\n"
        + sql
        + "\nROLLBACK;",
    ])

    if r.returncode:
        raise RuntimeError(
            r.stdout[-4000:]
        )

    return [
        x.strip()
        for x in r.stdout.splitlines()
        if x.strip()
        and x.strip()
        not in {
            "BEGIN",
            "ROLLBACK",
        }
    ]


def db_fingerprint():
    tables = prod_query("""
SELECT table_name
FROM information_schema.tables
WHERE table_schema='public'
AND table_type='BASE TABLE'
ORDER BY table_name;
""")

    rows = []

    for table in tables:
        safe = table.replace(
            '"',
            '""',
        )

        count = prod_query(
            f'SELECT count(*) '
            f'FROM public."{safe}";'
        )

        if len(count) != 1:
            raise RuntimeError(
                "invalid table count "
                + table
            )

        rows.append(
            f"{table}={count[0]}"
        )

    canonical = "\n".join(rows)

    return {
        "table_count":
            len(rows),

        "fingerprint":
            hashlib.sha256(
                canonical.encode()
            ).hexdigest(),
    }


