TAMANCARE_ENV=production

# Server and Domain Configuration
TAMANCARE_SERVER_NAME=care.example.org
TAMANCARE_TLS_DIR=/etc/letsencrypt/live/care.example.org
TAMANCARE_ACME_DIR=/var/www/certbot

# Database Configuration
POSTGRES_DB=taman_care
POSTGRES_USER=taman
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Application Secrets (Docker Secrets)
DATABASE_URL_FILE=/run/secrets/database_url
JWT_SECRET_FILE=/run/secrets/jwt_secret

# CORS Domain (Must match your public HTTPS domain)
CORS_ORIGIN=https://care.example.org

# Rate Limiting
RATE_LIMIT_PER_MINUTE=600

# Resource Allocations
API_MEMORY_LIMIT=768m
POSTGRES_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=256m
BACKUP_MEMORY_LIMIT=256m

API_CPU_LIMIT=1.50
POSTGRES_CPU_LIMIT=2.00
WEB_CPU_LIMIT=0.50
BACKUP_CPU_LIMIT=0.50
