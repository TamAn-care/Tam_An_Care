def exact_replace(
    text: str,
    old: str,
    new: str,
    label: str,
) -> str:
    count = text.count(old)

    print(
        f"PATCH_ANCHOR|{label}|COUNT={count}"
    )

    if count != 1:
        fail(
            f"{label} anchor count != 1"
        )

    return text.replace(
        old,
        new,
        1,
    )


def backup_file(path: Path) -> None:
    rel = path.relative_to(V80)

    target = (
        BACKUP_ROOT
        / rel
    )

    target.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    shutil.copy2(
        path,
        target,
    )


def restore_backups() -> None:
    if not BACKUP_ROOT.exists():
        return

    for source in BACKUP_ROOT.rglob("*"):
        if not source.is_file():
            continue

        rel = source.relative_to(
            BACKUP_ROOT
        )

        destination = (
            V80
            / rel
        )

        destination.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        shutil.copy2(
            source,
            destination,
        )

    if BOOTSTRAP.exists():
        try:
            BOOTSTRAP.unlink()
        except Exception:
            pass


def run(
    args: list[str],
    cwd: Path | None = None,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


