{
  "name": "tamancare_v80_full_demo",
  "networks": {
    "default": {
      "name": "tamancare_v80_full_demo_default",
      "ipam": {}
    }
  },
  "services": {
    "api": {
      "build": {
        "context": "/Users/anhha/Downloads/TamAnCare_V8_0_Full_Demo/api",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "depends_on": {
        "postgres": {
