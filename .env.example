# ==============================================================================
# Tâm An Care - Unified Environment Variables Example Template
# Copy this file to .env at the root or within api/ and frontend/
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=taman
POSTGRES_PASSWORD=taman_dev_password
POSTGRES_DB=taman_care
POSTGRES_PORT=5432
DATABASE_URL=postgresql://taman:taman_dev_password@localhost:5432/taman_care

# JWT Authentication (min 32 chars in production)
JWT_SECRET=change-this-development-secret-with-more-than-32-chars-long

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENABLE_SWAGGER=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=Tâm An Care - System Management
