def sql_value(
    container,
    user,
    database,
    sql,
):
    rc, out = run([
        "docker",
        "exec",
        container,
        "psql",
        "-X",
        "-U",
        user,
        "-d",
        database,
        "-At",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        sql,
    ])

    if rc:
        raise RuntimeError(
            out[-4000:]
        )

    lines = [
        x.strip()
        for x in out.splitlines()
        if x.strip()
    ]

    return lines[-1] if lines else ""


def resolve_source_db(
    preflight,
):
    d = preflight[
        "source_database"
    ]

    return (
        d["container"],
        d["user"],
        d["database"],
    )


