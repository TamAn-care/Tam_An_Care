def prod_query(sql):
    r = run([
        "docker",
        "exec",
        PROD_DB_CONTAINER,
        "psql",
        "-X",
        "-v",
        "ON_ERROR_STOP=1",
        "-U",
        PROD_DB_USER,
        "-d",
        PROD_DB_NAME,
        "-At",
        "-c",
        "BEGIN READ ONLY;\n"
        + sql
        + "\nROLLBACK;",
    ])

    if r.returncode:
        raise RuntimeError(
            r.stdout[-5000:]
        )

    return [
        x.strip()
        for x in r.stdout.splitlines()
        if x.strip()
        and x.strip()
        not in {
            "BEGIN",
            "ROLLBACK",
        }
    ]


def production_fingerprint():
    tables = prod_query("""
SELECT table_name
FROM information_schema.tables
WHERE table_schema='public'
AND table_type='BASE TABLE'
ORDER BY table_name;
""")

    canonical = []

    for table in tables:
        safe = table.replace(
            '"',
            '""',
        )

        c = prod_query(
            f'SELECT count(*) '
            f'FROM public."{safe}";'
        )

        if len(c) != 1:
            raise RuntimeError(
                "invalid table count result"
            )

        canonical.append(
            f"{table}={c[0]}"
        )

    raw = "\n".join(
        canonical
    )

    return {
        "table_count":
            len(tables),

        "fingerprint":
            hashlib.sha256(
                raw.encode()
            ).hexdigest(),
    }


