def disposable_query(
    env,
    sql,
):
    r = run([
        "docker",
        "exec",
        env["db"],
        "psql",
        "-X",
        "-v",
        "ON_ERROR_STOP=1",
        "-U",
        env["db_user"],
        "-d",
        env["db_name"],
        "-At",
        "-c",
        sql,
    ])

    if r.returncode:
        raise RuntimeError(
            r.stdout[-5000:]
        )

    return [
        x.strip()
        for x in r.stdout.splitlines()
        if x.strip()
    ]


