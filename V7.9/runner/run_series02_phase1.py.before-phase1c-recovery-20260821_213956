            safe_stop(
                gate,
                "no source-proven access mutation route found",
            )

        likely_fields = set(
            contract.get(
                "access_body_fields",
                [],
            )
        )

        print(
            "SOURCE_PROVEN_ACCESS_FIELDS="
            + ",".join(
                sorted(
                    likely_fields
                )
            )
        )

        resident_id = (
            "v79-s02-resident-"
            + uuid.uuid4().hex[:10]
        )

        staff_id = (
            "v79-s02-staff-"
            + uuid.uuid4().hex[:10]
        )

        payload = {}

        mappings = {
            "residentId":
                resident_id,

            "actorId":
                staff_id,

            "staffActorId":
                staff_id,

            "assignedActorId":
                staff_id,

            "role":
                "CAREGIVER",

            "actorRole":
                "CAREGIVER",

            "accessRole":
                "CAREGIVER",

            "assignedRole":
                "CAREGIVER",
        }

        for field, value in mappings.items():
            if field in likely_fields:
                payload[field] = value

        resident_field_present = any(
            k in payload
            for k in [
                "residentId",
            ]
        )

        staff_field_present = any(
            k in payload
            for k in [
                "actorId",
                "staffActorId",
                "assignedActorId",
            ]
        )

        if not (
            resident_field_present
            and
            staff_field_present
        ):
            safe_stop(
                gate,
                "exact resident-access payload cannot be built from source-proven fields without guessing",
            )

        selected_route = sorted(
            write_routes,
            key=lambda r: (
                0
                if r["method"]
                == "POST"
                else 1
            ),
        )[0]

        full_path = (
            "/"
            + selected_route[
                "controller"
            ].strip("/")
        )

        suffix = (
            selected_route[
                "route"
            ].strip("/")
        )

        if suffix:
            full_path += (
                "/"
                + suffix
            )

        if not full_path.startswith(
            "/api/"
        ):
            full_path = (
                "/api/"
                + full_path.lstrip("/")
            )

        replacements = {
            ":residentId":
                resident_id,

            ":actorId":
                staff_id,

            ":staffActorId":
                staff_id,
        }

        for token, value in replacements.items():
            full_path = full_path.replace(
                token,
                value,
            )

        if ":" in full_path:
            safe_stop(
                gate,
                "unresolved access-assignment path parameter remains",
            )

        access_tables = disposable_query(
            env,
            """
SELECT table_name
FROM information_schema.tables
WHERE table_schema='public'
AND table_type='BASE TABLE'
AND lower(table_name) LIKE '%access%'
ORDER BY table_name;
"""
        )

        before = {}

        for t in access_tables:
            safe = t.replace(
                '"',
                '""',
            )

            c = disposable_query(
                env,
                f'SELECT count(*) '
                f'FROM public."{safe}";'
            )

            before[t] = int(c[0])

        headers = {
            "x-actor-id":
                "v79-s02-supervisor",

            "x-actor-role":
                "SUPERVISOR",
        }

        http = curl_code(
            base
            + full_path,
            method=selected_route[
                "method"
            ],
            body=json.dumps(
                payload
            ),
            headers=headers,
        )

        body_file = Path(
            "/tmp/v79s02-body.txt"
        )

        body = (
            body_file.read_text(
                encoding="utf-8",
                errors="ignore",
            )
            if body_file.is_file()
            else ""
        )

        print(
            "ACCESS_MUTATION_METHOD="
            + selected_route[
                "method"
            ]
        )

        print(
            "ACCESS_MUTATION_ROUTE="
            + full_path
        )

        print(
            "ACCESS_MUTATION_HTTP="
            + http
        )

        print(
            "ACCESS_MUTATION_BODY="
            + body[:1000]
        )

        if http not in {
            "200",
            "201",
        }:
            safe_stop(
                gate,
                "source-proven isolated resident-access assignment did not succeed",
            )

        after = {}

        for t in access_tables:
            safe = t.replace(
                '"',
                '""',
            )

            c = disposable_query(
                env,
                f'SELECT count(*) '
                f'FROM public."{safe}";'
            )

            after[t] = int(c[0])

        delta = {
            t:
                after[t]
                - before[t]
            for t
            in before
        }

        positive_delta = {
            t: d
            for t, d
            in delta.items()
            if d > 0
        }

        print(
            "ACCESS_PERSISTENCE_DELTA="
            + json.dumps(
                positive_delta,
                sort_keys=True,
            )
        )

        if not positive_delta:
            safe_stop(
                gate,
                "access HTTP success produced no access-table persistence evidence",
            )

        inv = (
            INVENTORY
            / "V7.9-PHASE-1D-RESIDENT-ACCESS-DISPOSABLE-WORKFLOW.json"
        )

        inv.write_text(
            json.dumps(
                {
                    "version":
                        "V7.9",

                    "phase":
                        "1D",

                    "status":
                        "PASSED",

                    "isolated":
                        True,

                    "route":
                        full_path,

                    "method":
                        selected_route[
                            "method"
                        ],

                    "payload_fields":
                        sorted(
                            payload.keys()
                        ),

                    "http":
                        http,

                    "persistence_delta":
                        positive_delta,

                    "real_resident_mutation":
                        False,

                    "production_mutation":
                        False,
                },
                indent=2,
                ensure_ascii=False,
            ) + "\n",
            encoding="utf-8",
        )

        result = (
            RESULTS
            / "V7.9-PHASE-1D-RESIDENT-ACCESS-DISPOSABLE-WORKFLOW-RESULT.txt"
        )

        manifest = (
            MANIFESTS
            / "V7.9-PHASE-1D-RESIDENT-ACCESS-DISPOSABLE-WORKFLOW.json"
        )

        manifest.write_text(
