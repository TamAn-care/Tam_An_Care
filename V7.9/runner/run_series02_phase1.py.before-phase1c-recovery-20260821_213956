def read_api_source():
    files = []

    for p in API_SRC.rglob("*.ts"):
        if any(
            part == "node_modules"
            for part in p.parts
        ):
            continue

        files.append(p)

    contents = {}

    for p in files:
        contents[p] = p.read_text(
            encoding="utf-8",
            errors="ignore",
        )

    return contents


def route_inventory(
    contents,
):
    records = []

    for p, text in contents.items():
        controller = re.search(
            r'@Controller\s*\(\s*'
            r'["\']([^"\']*)["\']'
            r'\s*\)',
            text,
            re.I,
        )

        base = (
            controller.group(1)
            if controller
            else ""
        )

        for m in re.finditer(
            r'@(Get|Post|Put|Patch|Delete)'
            r'\s*\(\s*'
            r'(?:["\']([^"\']*)["\'])?'
            r'\s*\)',
            text,
            re.I,
        ):
            records.append({
                "file":
                    str(
                        p.relative_to(
                            API_SRC
                        )
                    ),

                "method":
                    m.group(1).upper(),

                "controller":
                    base,

                "route":
                    m.group(2)
                    or "",
            })

    return records


def source_candidates(
    contents,
    words,
):
    matches = []

    for p, text in contents.items():
        lower = text.lower()

        score = sum(
            1
            for w in words
            if w.lower()
            in lower
        )

        if score:
            matches.append(
                (
                    score,
                    p,
                    text,
                )
            )

    return sorted(
        matches,
        reverse=True,
        key=lambda x: x[0],
    )


def extract_body_fields(
    text,
):
    fields = set()

    patterns = [
        r'body\.([A-Za-z_][A-Za-z0-9_]*)',
        r'input\.([A-Za-z_][A-Za-z0-9_]*)',
        r'dto\.([A-Za-z_][A-Za-z0-9_]*)',
        r'payload\.([A-Za-z_][A-Za-z0-9_]*)',
        r'@Body\(\)\s*[A-Za-z_][A-Za-z0-9_]*\s*:\s*\{([^}]*)\}',
    ]

    for pattern in patterns[:-1]:
        for m in re.finditer(
            pattern,
            text,
        ):
            fields.add(
                m.group(1)
            )

    for m in re.finditer(
        patterns[-1],
        text,
        re.S,
    ):
        block = m.group(1)

        for f in re.findall(
            r'([A-Za-z_][A-Za-z0-9_]*)\s*[?:]',
            block,
        ):
            fields.add(f)

    return sorted(fields)


def exact_table_contract(
    keyword,
):
    tables = prod_query("""
SELECT table_name
FROM information_schema.tables
WHERE table_schema='public'
AND table_type='BASE TABLE'
ORDER BY table_name;
""")

    selected = [
        t
        for t in tables
        if keyword.lower()
        in t.lower()
    ]

    contracts = {}

    for table in selected:
        safe = table.replace(
            "'",
            "''",
        )

        rows = prod_query(f"""
SELECT
  ordinal_position || '|' ||
  column_name || '|' ||
  data_type || '|' ||
  is_nullable || '|' ||
  COALESCE(column_default,'<NONE>')
FROM information_schema.columns
WHERE table_schema='public'
AND table_name='{safe}'
ORDER BY ordinal_position;
""")

        contracts[
            table
        ] = rows

    return contracts


def free_port():
    s = socket.socket()
    s.bind(
        (
            "127.0.0.1",
            0,
        )
    )

    port = s.getsockname()[1]
    s.close()

    return port


def wait_postgres(
    container,
    user,
    db,
):
    consecutive = 0

    for i in range(
        1,
        31,
    ):
        ready = run([
            "docker",
            "exec",
            container,
            "pg_isready",
            "-U",
            user,
            "-d",
            db,
        ])

        sql = run([
            "docker",
            "exec",
            container,
            "psql",
            "-U",
            user,
            "-d",
            db,
            "-At",
            "-c",
            "SELECT 1;",
        ])

        ok = (
            ready.returncode == 0
            and
            sql.returncode == 0
            and
            sql.stdout.strip()
            == "1"
        )

        print(
            f"DB_READY_{i}="
            + (
                "PASS"
                if ok
                else "WAIT"
            )
        )

        if ok:
            consecutive += 1
        else:
            consecutive = 0

        if consecutive >= 3:
            return True

        time.sleep(1)

    return False


def wait_http(
    url,
    attempts=30,
):
    for i in range(
        1,
        attempts + 1,
    ):
        code = curl_code(
            url
        )

        print(
            f"HTTP_WAIT_{i}|"
            f"{url}|{code}"
        )

        if code == "200":
            return True

        time.sleep(1)

    return False


