def docker_infos():
    r = run([
        "docker",
        "ps",
        "-aq",
        "--no-trunc",
    ])

    infos = []

    for cid in r.stdout.split():
        i = run([
            "docker",
            "inspect",
            cid,
        ])

        if i.returncode:
            continue

        try:
            infos.append(
                json.loads(
                    i.stdout
                )[0]
            )
        except Exception:
            pass

    return infos


def resolve_running_image(
    image_id,
):
    for info in docker_infos():
        if (
            info.get("Image")
            == image_id
            and
            info.get(
                "State",
                {},
            ).get(
                "Status"
            )
            == "running"
        ):
            return info

    return None


def cname(info):
    return info.get(
        "Name",
        "",
    ).lstrip("/")


def curl_code(
    url,
    method="GET",
    body=None,
    headers=None,
):
    cmd = [
        "curl",
        "-sS",
        "--max-time", "6",
        "-o", "/tmp/v79s02-body.txt",
        "-w", "%{http_code}",
    ]

    if method != "GET":
        cmd += [
            "-X",
            method,
        ]

    if headers:
        for key, value in headers.items():
            cmd += [
                "-H",
                f"{key}: {value}",
            ]

    if body is not None:
        cmd += [
            "-H",
            "Content-Type: application/json",
            "--data",
            body,
        ]

    cmd.append(url)

    r = run(cmd)

    return (
        r.stdout.strip()
        if r.stdout.strip()
        else "000"
    )


