                ensure_ascii=False,
            ) + "\n",
            encoding="utf-8",
        )

        result.write_text(
            "\n".join([
                "TAM AN CARE V7.9",
                "PHASE 1D",
                "STATUS=PASSED",
                "EXECUTION=DISPOSABLE_ONLY",
                f"ACCESS_MUTATION_HTTP={http}",
                "ACCESS_PERSISTENCE=PASSED",
                "REAL_RESIDENT_MUTATION=NO",
                "PRODUCTION_DATABASE_MUTATION=NO",
                "NEXT=PHASE_1_FINAL",
            ]) + "\n",
            encoding="utf-8",
        )

    finally:
        if env:
            cleanup_disposable(
                api=env["api"],
                db=env["db"],
                network=env["network"],
            )

