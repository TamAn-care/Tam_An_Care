def completed_entry(gate):
    for item in STATE.get(
        "completed",
        [],
    ):
        if item.get("gate") == gate:
            return item

    return None


def maybe_skip(gate):
    item = completed_entry(gate)

    if not item:
        return False

    for key in [
        "result",
        "manifest",
    ]:
        path_value = item.get(key)

        if not path_value:
            continue

        p = Path(path_value)

        if not p.is_file():
            safe_stop(
                gate,
                f"accepted {key} missing",
            )

        expected_hash = item.get(
            key + "_hash"
        )

        if sha(p) != expected_hash:
            safe_stop(
                gate,
                f"accepted {key} hash changed",
            )

    print()
    print(
        f"SKIP_ALREADY_ACCEPTED_{gate}=YES"
    )
    print(
        f"PASS: {gate} ACCEPTED EVIDENCE PRESERVED"
    )

    return True


