# Tâm An Care Frontend - Environment Variables Template
# Copy to .env for local development overrides.
# In "Build Once, Deploy Anywhere" architecture:
# - Leave VITE_API_BASE_URL empty for origin-relative /api routing (default)
# - Or configure runtime overrides in public/config.js (window.__TAMAN_CONFIG__)

# API Base URL (default is empty string '' for origin-relative /api requests)
# In development, Vite proxies /api to http://127.0.0.1:3000
# In production, Nginx proxies /api to http://api:3000
VITE_API_BASE_URL=

# App Branding
VITE_APP_TITLE=Tâm An Care - System Management

# Dev Feature Guarding: set to 'true' to show quick staff switcher in production testing
VITE_ENABLE_DEV_SWITCHER=false
